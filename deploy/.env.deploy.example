# HS Global — Deployment Credentials
# ─────────────────────────────────────────────────────────────────────────────
# STEP 1: Copy this file → deploy/.env.deploy
# STEP 2: Fill in every value below
# STEP 3: Never commit .env.deploy to git (it is already in .gitignore)
# ─────────────────────────────────────────────────────────────────────────────

# ── GoDaddy cPanel FTP (Frontend) ────────────────────────────────────────────
# Find these in GoDaddy cPanel → FTP Accounts
FTP_HOST=ftp.yourdomain.com
FTP_USER=your_cpanel_username
FTP_PASS=your_ftp_password
# Remote folder on GoDaddy where index.html should live
FTP_REMOTE_PATH=/public_html

# ── DigitalOcean VPS (Backend) ───────────────────────────────────────────────
# Your Droplet's public IP address
VPS_HOST=123.456.789.10
# SSH login user (usually root or ubuntu)
VPS_USER=root
# Absolute path to your SSH private key
# Windows example: C:/Users/YourName/.ssh/id_rsa
# Mac/Linux example: /home/yourname/.ssh/id_rsa
VPS_SSH_KEY_PATH=C:/Users/YourName/.ssh/id_rsa
# Absolute path on the VPS where the repo is cloned
VPS_APP_PATH=/var/www/hs-global
# Git branch to deploy
VPS_GIT_BRANCH=main
