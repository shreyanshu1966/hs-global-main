# HS Global — Deployment Credentials
# ─────────────────────────────────────────────────────────────────────────────
# STEP 1: Copy this file → deploy/.env.deploy
# STEP 2: Fill in every value below
# STEP 3: Never commit .env.deploy to git (it is already in .gitignore)
#
# SSH auth: set VPS_SSH_KEY_PATH if you have a key, otherwise set vps_pass.
# The deploy scripts use Python + paramiko (no sshpass needed on Windows).
# ─────────────────────────────────────────────────────────────────────────────

# ── GoDaddy cPanel FTP (Old Frontend) ────────────────────────────────────────
FTP_HOST=ftp.yourdomain.com
FTP_USER=your_cpanel_username
FTP_PASS=your_ftp_password
FTP_REMOTE_PATH=/public_html

# ── DigitalOcean VPS ─────────────────────────────────────────────────────────
VPS_HOST=123.456.789.10
VPS_USER=root

# SSH key (preferred). Leave blank to use password instead.
# Windows: C:/Users/YourName/.ssh/id_rsa
# Mac/Linux: /home/yourname/.ssh/id_rsa
VPS_SSH_KEY_PATH=

# SSH password (used only when no key is set above)
vps_pass=your_vps_password

# Absolute path on the VPS where the repo is cloned
VPS_APP_PATH=/var/www/hs-global

# Git branch for the BACKEND (Express API) — typically main
VPS_GIT_BRANCH=main

# Git branch for the FRONTEND (Next.js) — frontend-new/ lives here
# This is separate from VPS_GIT_BRANCH because frontend and backend
# may be on different branches (e.g. frontend on Home, backend on main).
VPS_FRONTEND_BRANCH=Home
