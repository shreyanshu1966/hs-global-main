<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

# Enable GZIP compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  
  # Images - Long cache (1 year)
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  
  # CSS - Long cache (1 year)
  ExpiresByType text/css "access plus 1 year"

  # JavaScript - Long cache (1 year)
  # Covers all common JS mime types
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  
  # Fonts - Long cache (1 year)
  ExpiresByType font/woff2 "access plus 1 year"
  
  # Others
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>

# Cache-Control Headers
<IfModule mod_headers.c>
  # 1 Year for static assets (JS, CSS, Images, Fonts)
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|webp|svg|ico|woff2)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>
  
  # No caching for HTML to ensure updates are seen immediately
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  
  # Security Headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>


