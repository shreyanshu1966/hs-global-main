# Review Seeding Configuration
# Modify these settings to customize the review generation process

# Review quantity settings
REVIEWS_PER_PRODUCT_MIN=3
REVIEWS_PER_PRODUCT_MAX=8

# Rating distribution (percentage likelihood) - ONLY GOOD REVIEWS
# These should add up to 100
RATING_5_STAR_PERCENT=70
RATING_4_STAR_PERCENT=30
RATING_3_STAR_PERCENT=0   # Disabled - only good reviews
RATING_2_STAR_PERCENT=0   # Disabled - only good reviews  
RATING_1_STAR_PERCENT=0   # Disabled - only good reviews

# Review approval settings
VERIFIED_REVIEW_PERCENT=70
APPROVED_REVIEW_PERCENT=90

# Date range for reviews (days ago)
OLDEST_REVIEW_DAYS=90  # 3 months
NEWEST_REVIEW_DAYS=7   # 1 week

# Database settings
CLEAR_EXISTING_REVIEWS=true  # Set to false to keep existing reviews