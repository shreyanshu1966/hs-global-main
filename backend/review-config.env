# Review Seeding Configuration
# Loaded by seed-reviews.js (values here are overridden by your real .env if it
# defines the same key). Tune review generation without editing the script.

# Review quantity per product (defaults preserve historical behaviour)
REVIEWS_PER_PRODUCT_MIN=100
REVIEWS_PER_PRODUCT_MAX=150

# Rating distribution - ONLY GOOD REVIEWS (targets a ~4.85 average)
# Percentage of reviews that are 5-star; the remainder become 4-star.
RATING_5_STAR_PERCENT=85

# Review approval settings (percentages)
VERIFIED_REVIEW_PERCENT=90
APPROVED_REVIEW_PERCENT=95

# Date range for reviews (days ago)
OLDEST_REVIEW_DAYS=365
NEWEST_REVIEW_DAYS=7

# Database settings
CLEAR_EXISTING_REVIEWS=true  # Set to false to keep existing reviews
