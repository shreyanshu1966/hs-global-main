{
    "name": "hs-global-backend",
    "version": "1.0.0",
    "description": "Backend API for HS Global",
    "main": "server.js",
    "type": "commonjs",
    "scripts": {
        "start": "node server.js",
        "dev": "node --watch server.js",
        "setup-auth": "node setup-auth.js",
        "migrate-products": "node migrate-products.js",
        "test-auth": "node test-auth-flow.js",
        "seed-reviews": "node seed-reviews.js",
        "test-reviews": "node test-reviews.js",
        "update-ratings": "node update-product-ratings.js",
        "seed-blogs": "node seed-blogs.js",
        "test-crud": "node test-product-crud.js",
        "check-indexes": "node check-discount-indexes.js",
        "fix-indexes": "node ensure-discount-indexes.js",
        "fix-discounts": "node ensure-discount-indexes.js",
        "migrate-furniture:dry": "node scripts/migrate-furniture-db.js --dry-run",
        "migrate-furniture:apply": "node scripts/migrate-furniture-db.js --apply",
        "migrate:bootstrap"       : "node migrate-bootstrap.js",
        "migrate:kewal-step1"     : "node migrate-kewal-products.js --step=1",
        "migrate:kewal-step1-dry" : "node migrate-kewal-products.js --step=1 --dry-run",
        "migrate:kewal-step2"     : "node migrate-kewal-products.js --step=2",
        "migrate:kewal-step2-dry" : "node migrate-kewal-products.js --step=2 --dry-run",
        "migrate:kewal-step3"     : "node migrate-kewal-products.js --step=3",
        "migrate:kewal-step3-dry" : "node migrate-kewal-products.js --step=3 --dry-run",
        "migrate:kewal-price-prepare"     : "node migrate-kewal-products.js --step=3 --price-mode=prepare",
        "migrate:kewal-price-prepare-dry" : "node migrate-kewal-products.js --step=3 --price-mode=prepare --dry-run",
        "migrate:kewal-price-apply"       : "node migrate-kewal-products.js --step=3 --price-mode=apply",
        "migrate:kewal-price-apply-dry"   : "node migrate-kewal-products.js --step=3 --price-mode=apply --dry-run",
        "delete-prices:dry"               : "node scripts/delete-all-prices.js",
        "delete-prices:apply"             : "node scripts/delete-all-prices.js --apply",
        "migrate:etsy-serial:dry"         : "node scripts/migrate-etsy-serial-products.js --dry-run",
        "migrate:etsy-serial:apply"       : "node scripts/migrate-etsy-serial-products.js --apply"
    },
    "dependencies": {
        "axios": "^1.13.4",
        "basic-ftp": "^5.0.5",
        "bcryptjs": "^3.0.3",
        "body-parser": "^1.20.2",
        "cloudinary": "^2.8.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "csv-parse": "^6.1.0",
        "csv-parser": "^3.2.0",
        "dotenv": "^16.6.1",
        "express": "^4.22.1",
        "form-data": "^4.0.0",
        "google-auth-library": "^10.6.2",
        "jsonwebtoken": "^9.0.3",
        "lokijs": "^1.5.12",
        "mongoose": "^9.0.2",
        "multer": "^2.0.2",
        "node-cron": "^4.2.1",
        "nodemailer": "^6.10.1",
        "sharp": "^0.33.5",
        "twilio": "^5.9.0"
    }
}
